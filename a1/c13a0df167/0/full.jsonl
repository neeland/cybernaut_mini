el2VecEmbedder\n\n    if meta.embedding_model.startswith(Model2VecEmbedder.PREFIX):\n        if offline:\n            msg = (\n                \"offline mode: embedding provider 'model2vec' may require a model \"\n                \"download; use an index built with provider 'hash'\"\n            )\n            raise ConfigError(msg)\n        model_name = meta.embedding_model[len(Model2VecEmbedder.PREFIX) :]\n        # Reuse the build-time revision so query vectors come from the same weights\n        # as the stored document vectors.\n        return Model2VecEmbedder(model_name, revision=meta.embedding_revision)\n\n    if offline:\n        msg = (\n            \"offline mode: embedding provider 'sentence_transformers' may require a \"\n            \"model download; use an index built with provider 'hash'\"\n        )\n        raise ConfigError(msg)\n    from cybernaut_mini.providers.embeddings import SentenceTransformersEmbedder\n\n    return SentenceTransformersEmbedder(meta.embedding_model, revision=meta.embedding_revision)"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":719,"cache_read_input_tokens":206234,"output_tokens":1383,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":719,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":1,"output_tokens":1383,"cache_read_input_tokens":206234,"cache_creation_input_tokens":719,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":719},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Cdq2Zdg11tsqMUvNYrWBE","type":"assistant","uuid":"b8788144-448a-449a-b0eb-22c7a231584e","timestamp":"2026-08-08T09:15:43.934Z","effort":"high","session_id":"1739850f-85bf-4d10-b02b-a0b2492e7df8","userType":"external","entrypoint":"cli","cwd":"/workspaces/cyberna