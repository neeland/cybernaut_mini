{"parentUuid":"f8d9c304-c412-4339-9b9e-e4baf1f4dde2","isSidechain":false,"promptId":"c04746bc-44d0-4339-ab78-adcbaf66e058","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PmjKUV5GQaWYs7ST7drs9g","type":"tool_result","content":"1\t\"\"\"Configuration models and layered loading.\n2\t\n3\tPrecedence (highest wins): CLI overrides > environment variables > YAML file > defaults.\n4\tEnvironment variables use the prefix ``CYBERNAUT_MINI__`` with ``__`` as the section\n5\tseparator, e.g. ``CYBERNAUT_MINI__EMBEDDING__PROVIDER=hash``.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport os\n11\tfrom pathlib import Path\n12\tfrom typing import Any, Literal\n13\t\n14\timport yaml\n15\tfrom pydantic import BaseModel, ConfigDict, Field\n16\t\n17\tENV_PREFIX = \"CYBERNAUT_MINI__\"\n18\t\n19\t\n20\tclass ConfigError(ValueError):\n21\t    \"\"\"Raised for invalid or unusable configuration.\"\"\"\n22\t\n23\t\n24\tclass EmbeddingConfig(BaseModel):\n25\t    model_config = ConfigDict(extra=\"forbid\")\n26\t\n27\t    # Defaults to the offline provider so a bare `kedro run` or `cybernaut-mini build`\n28\t    # works on the default install. 'sentence_transformers' is the quality option but\n29\t    # lives behind the optional 'st' extra, so it must be opted into explicitly\n30\t    # (configs/default.yaml, or --env prod).\n31\t    provider: Literal[\"hash\", \"sentence_transformers\"] = \"hash\"\n32\t    model: str = \"intfloat/multilingual-e5-small\"\n33\t    revision: str | None = Field(\n34\t        default=None,\n35\t        description=(\n36\t            \"Commit SHA or tag of the model weights. None resolves to the repo's \"\n37\t            \"default branch and is not reproducible; pin it for production builds.\"\n38\t        ),\n39\t    )\n40\t    dim: int = Field(default=256, ge=8, description=\"Vector size for the hash provider\")\n41\t\n42\t    def is_pinned(self) -> bool:\n43\t        \"\"\"True when this configuration identifies exactly one set of weights.\"\"\"\n44\t        if self.provider == \"hash\":\n45\t            # The hash embedder is pure code — no weights to drift.\n46\t            return True\n47\t        revision = self.revision\n48\t        if revision is None:\n49\t            return False\n50\t        return revision.strip().lower() not in {\"main\", \"master\", \"head\"}\n51\t\n52\t\n53\tclass IndexConfig(BaseModel):\n54\t    model_config = ConfigDict(extra=\"forbid\")\n55\t\n56\t    n_shards: int = Field(default=12, ge=1)\n57\t    max_keywords: int = Field(default=30, ge=1)\n58\t    max_entities: int = Field(default=30, ge=1)\n59\t    cooccurrence_window: int = Field(default=5, ge=2)\n60\t    min_edge_count: int = Field(default=2, ge=1)\n61\t\n62\t\n63\tclass RRFConfig(BaseModel):\n64\t    model_config = ConfigDict(extra=\"forbid\")\n65\t\n66\t    k: int = Field(default=60, ge=1)\n67\t    dense_weight: float = Field(default=1.0, ge=0.0)\n68\t    lexical_weight: float = Field(default=1.0, ge=0.0)\n69\t    entity_weight: float = Field(default=0.5, ge=0.0)\n70\t\n71\t\n72\tclass AgentConfig(BaseModel):\n73\t    model_config = ConfigDict(extra=\"forbid\")\n74\t\n75\t    exploration_constant: float = Field(default=1.2, ge=0.0)\n76\t    max_expansions: int = Field(default=5, ge=0)\n77\t    max_retrieval_calls: int = Field(default=18, ge=1)\n78\t    judge: Literal[\"heuristic\"] = \"heuristic\"\n79\t    query_generator: Literal[\"heuristic\"] = \"heuristic\"\n80\t\n81\t\n82\tclass AppConfig(BaseModel):\n83\t    model_config = ConfigDict(extra=\"forbid\")\n84\t\n85\t    seed: int = 42\n86\t    embedding: EmbeddingConfig = Field(default_factory=EmbeddingConfig)\n87\t    index: IndexConfig = Field(default_factory=IndexConfig)\n88\t    rrf: RRFConfig = Field(default_factory=RRFConfig)\n89\t    agent: AgentConfig = Field(default_factory=AgentConfig)\n90\t\n91\t    def require_offline_compatible(self) -> None:\n92\t        \"\"\"Reject configurations that would require network access (``--offline``).\"\"\"\n93\t        if self.embedding.provider == \"sentence_transformers\":\n94\t            msg = (\n95\t                \"offline mode: embedding provider 'sentence_transformers' may require a \"\n96\t                \"model download; use provider 'hash' (e.g. configs/tiny.yaml)\"\n97\t            )\n98\t            raise ConfigError(msg)\n99\t\n100\t    def require_reproducible(self) -> None:\n101\t        \"\"\"Reject configurations that cannot be rebuilt to the same bytes later.\n102\t\n103\t        An index is only reproducible from ``(corpus, config, seed)`` if the weights\n104\t        that produced its vectors are pinned. Enforced for production builds, where\n105\t        an unnoticed weight change would silently invalidate every stored vector.\n106\t        \"\"\"\n107\t        if not self.embedding.is_pinned():\n108\t            msg = (\n109\t                f\"embedding model {self.embedding.model!r} is not pinned \"\n110\t                f\"(revision={self.embedding.revision!r}); set embedding.revision to a \"\n111\t                f\"commit SHA so the index can be rebuilt byte-for-byte\"\n112\t            )\n113\t            raise ConfigError(msg)\n114\t\n115\t\n116\tdef _deep_merge(base: dict[str, Any], override: dict[str, Any]) -> dict[str, Any]:\n117\t    merged = dict(base)\n118\t    for key, value in override.items():\n119\t        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n120\t            merged[key] = _deep_merge(merged[key], value)\n121\t        else:\n122\t            merged[key] = value\n123\t    return merged\n124\t\n125\t\n126\tdef _env_overrides(environ: dict[str, str]) -> dict[str, Any]:\n127\t    result: dict[str, Any] = {}\n128\t    for name, raw in environ.items():\n129\t        if not name.startswith(ENV_PREFIX):\n130\t            continue\n131\t        path = [part.lower() for part in name[len(ENV_PREFIX) :].split(\"__\") if part]\n132\t        if not path:\n133\t            continue\n134\t        node = result\n135\t        for part in path[:-1]:\n136\t            node = node.setdefault(part, {})\n137\t        node[path[-1]] = yaml.safe_load(raw)\n138\t    return result\n139\t\n140\t\n141\tdef load_config(\n142\t    config_path: Path | None = None,\n143\t    *,\n144\t    environ: dict[str, str] | None = None,\n145\t    overrides: dict[str, Any] | None = None,\n146\t) -> AppConfig:\n147\t    layers: dict[str, Any] = {}\n148\t    if config_path is not None:\n149\t        raw = yaml.safe_load(config_path.read_text(encoding=\"utf-8\")) or {}\n150\t        if not isinstance(raw, dict):\n151\t            msg = f\"config file {config_path} must contain a mapping\"\n152\t            raise ConfigError(msg)\n153\t        layers = _deep_merge(layers, raw)\n154\t    env = environ if environ is not None else dict(os.environ)\n155\t    layers = _deep_merge(layers, _env_overrides(env))\n156\t    if overrides:\n157\t        layers = _deep_merge(layers, overrides)\n158\t    try:\n159\t        return AppConfig.model_validate(layers)\n160\t    except ValueError as exc:\n161\t        raise ConfigError(str(exc)) from exc\n162\t"}]},"uuid":"9b998b44-4cdc-4311-b4a4-00cdb28ffe5a","timestamp":"2026-08-08T09:12:08.931Z","toolUseResult":{"type":"text","file":{"filePath":"/workspaces/cybernaut_mini/src/cybernaut_mini/config.py","content":"\"\"\"Configuration models and layered loading.\n\nPrecedence (highest wins): CLI overrides > environment variables > YAML file > defaults.\nEnvironment variables use the prefix ``CYBERNAUT_MINI__`` with ``__`` as the section\nseparator, e.g. ``CYBERNAUT_MINI__EMBEDDING__PROVIDER=hash``.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nfrom pathlib import Path\nfrom typing import Any, Literal\n\nimport yaml\nfrom pydantic import BaseModel, ConfigDict, Field\n\nENV_PREFIX = \"CYBERNAUT_MINI__\"\n\n\nclass ConfigError(ValueError):\n    \"\"\"Raised for invalid or unusable configuration.\"\"\"\n\n\nclass EmbeddingConfig(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    # Defaults to the offline provider so a bare `kedro run` or `cybernaut-mini build`\n    # works on the default install. 'sentence_transformers' is the quality option but\n    # lives behind the optional 'st' extra, so it must be opted into explicitly\n    # (configs/default.yaml, or --env prod).\n    provider: Literal[\"hash\", \"sentence_transformers\"] = \"hash\"\n    model: str = \"intfloat/multilingual-e5-small\"\n    revision: str | None = Field(\n        default=None,\n        description=(\n            \"Commit SHA or tag of the model weights. None resolves to the repo's \"\n            \"default branch and is not reproducible; pin it for production builds.\"\n        ),\n    )\n    dim: int = Field(default=256, ge=8, description=\"Vector size for the hash provider\")\n\n    def is_pinned(self) -> bool:\n        \"\"\"True when this configuration identifies exactly one set of weights.\"\"\"\n        if self.provider == \"hash\":\n            # The hash embedder is pure code — no weights to drift.\n            return True\n        revision = self.revision\n        if revision is None:\n            return False\n        return revision.strip().lower() not in {\"main\", \"master\", \"head\"}\n\n\nclass IndexConfig(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    n_shards: int = Field(default=12, ge=1)\n    max_keywords: int = Field(default=30, ge=1)\n    max_entities: int = Field(default=30, ge=1)\n    cooccurrence_window: int = Field(default=5, ge=2)\n    min_edge_count: int = Field(default=2, ge=1)\n\n\nclass RRFConfig(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    k: int = Field(default=60, ge=1)\n    dense_weight: float = Field(default=1.0, ge=0.0)\n    lexical_weight: float = Field(default=1.0, ge=0.0)\n    entity_weight: float = Field(default=0.5, ge=0.0)\n\n\nclass AgentConfig(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    exploration_constant: float = Field(default=1.2, ge=0.0)\n    max_expansions: int = Field(default=5, ge=0)\n    max_retrieval_calls: int = Field(default=18, ge=1)\n    judge: Literal[\"heuristic\"] = \"heuristic\"\n    query_generator: Literal[\"heuristic\"] = \"heuristic\"\n\n\nclass AppConfig(BaseModel):\n    model_config = ConfigDict(extra=\"forbid\")\n\n    seed: int = 42\n    embedding: EmbeddingConfig = Field(default_factory=EmbeddingConfig)\n    index: IndexConfig = Field(default_factory=IndexConfig)\n    rrf: RRFConfig = Field(default_factory=RRFConfig)\n    agent: AgentConfig = Field(default_factory=AgentConfig)\n\n    def require_offline_compatible(self) -> None:\n        \"\"\"Reject configurations that would require network access (``--offline``).\"\"\"\n        if self.embedding.provider == \"sentence_transformers\":\n            msg = (\n                \"offline mode: embedding provider 'sentence_transformers' may require a \"\n                \"model download; use provider 'hash' (e.g. configs/tiny.yaml)\"\n            )\n            raise ConfigError(msg)\n\n    def require_reproducible(self) -> None:\n        \"\"\"Reject configurations that cannot be rebuilt to the same bytes later.\n\n        An index is only reproducible from ``(corpus, config, seed)`` if the weights\n        that produced its vectors are pinned. Enforced for production builds, where\n        an unnoticed weight change would silently invalidate every stored vector.\n        \"\"\"\n        if not self.embedding.is_pinned():\n            msg = (\n                f\"embedding model {self.embedding.model!r} is not pinned \"\n                f\"(revision={self.embedding.revision!r}); set embedding.revision to a \"\n                f\"commit SHA so the index can be rebuilt byte-for-byte\"\n            )\n            raise ConfigError(msg)\n\n\ndef _deep_merge(base: dict[str, Any], override: dict[str, Any]) -> dict[str, Any]:\n    merged = dict(base)\n    for key, value in override.items():\n        if isinstance(value, dict) and isinstance(merged.get(key), dict):\n            merged[key] = _deep_merge(merged[key], value)\n        else:\n            merged[key] = value\n    return merged\n\n\ndef _env_overrides(environ: dict[str, str]) -> dict[str, Any]:\n    result: dict[str, Any] = {}\n    for name, raw in environ.items():\n        if not name.startswith(ENV_PREFIX):\n            continue\n        path = [part.lower() for part in name[len(ENV_PREFIX) :].split(\"__\") if part]\n        if not path:\n            continue\n        node = result\n        for part in path[:-1]:\n            node = node.setdefault(part, {})\n        node[path[-1]] = yaml.safe_load(raw)\n    return result\n\n\ndef load_config(\n    config_path: Path | None = None,\n    *,\n    environ: dict[str, str] | None = None,\n    overrides: dict[str, Any] | None = None,\n) -> AppConfig:\n    layers: dict[str, Any] = {}\n    if config_path is not None:\n        raw = yaml.safe_load(config_path.read_text(encoding=\"utf-8\")) or {}\n        if not isinstance(raw, dict):\n            msg = f\"config file {config_path} must contain a mapping\"\n            raise ConfigError(msg)\n        layers = _deep_merge(layers, raw)\n    env = environ if environ is not None else dict(os.environ)\n    layers = _deep_merge(layers, _env_overrides(env))\n    if overrides:\n        layers = _deep_merge(layers, overrides)\n    try:\n        return AppConfig.model_validate(layers)\n    except ValueError as exc:\n        raise ConfigError(str(exc)) from exc\n","numLines":162,"startLine":1,"totalLines":162}},"sourceToolAssistantUUID":"f8d9c304-c412-4339-9b9e-e4baf1f4dde2","session_id":"1739850f-85bf-4d10-b02b-a0b2492e7df8","userType":"external","entrypoint":"cli","cwd":"/workspaces/cybernaut_mini","sessionId":"1739850f-85bf-4d10-b02b-a0b2492e7df8","version":"2.1.223","gitBranch":"main"}
