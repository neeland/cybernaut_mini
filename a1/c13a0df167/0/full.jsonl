{"parentUuid":"245aecc8-4b6a-46d7-bd67-2044d2fcb87d","isSidechain":false,"promptId":"c04746bc-44d0-4339-ab78-adcbaf66e058","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XJmMmM8tGyPNMpCHrGW4Ws","type":"tool_result","content":"1\t\"\"\"Embedding providers behind a common protocol.\n2\t\n3\t``HashEmbedder`` is a first-class deterministic offline provider (feature hashing of\n4\ttokens and character trigrams), not a test mock. ``SentenceTransformersEmbedder``\n5\twraps E5-style models and is the quality option; it may download weights on first use.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport hashlib\n11\timport os\n12\tfrom typing import Protocol\n13\t\n14\timport numpy as np\n15\timport numpy.typing as npt\n16\t\n17\tfrom cybernaut_mini.config import ConfigError, EmbeddingConfig\n18\tfrom cybernaut_mini.text import TextProcessor\n19\t\n20\tFloatArray = npt.NDArray[np.float32]\n21\t\n22\t\n23\tclass EmbeddingProvider(Protocol):\n24\t    @property\n25\t    def identifier(self) -> str: ...\n26\t\n27\t    @property\n28\t    def dim(self) -> int: ...\n29\t\n30\t    def embed_documents(self, texts: list[str]) -> FloatArray: ...\n31\t\n32\t    def embed_queries(self, texts: list[str]) -> FloatArray: ...\n33\t\n34\t\n35\tdef l2_normalize(matrix: FloatArray) -> FloatArray:\n36\t    norms = np.linalg.norm(matrix, axis=1, keepdims=True)\n37\t    norms[norms == 0.0] = 1.0\n38\t    return (matrix / norms).astype(np.float32)\n39\t\n40\t\n41\tclass HashEmbedder:\n42\t    \"\"\"Deterministic feature-hashing embedder: tokens + char trigrams -> signed buckets.\"\"\"\n43\t\n44\t    def __init__(self, dim: int = 256) -> None:\n45\t        self._dim = dim\n46\t        self._processor = TextProcessor(use_spacy=False)\n47\t\n48\t    @property\n49\t    def identifier(self) -> str:\n50\t        return f\"hash-{self._dim}\"\n51\t\n52\t    @property\n53\t    def dim(self) -> int:\n54\t        return self._dim\n55\t\n56\t    def _features(self, text: str) -> list[str]:\n57\t        tokens = self._processor.tokenize(text)\n58\t        features = list(tokens)\n59\t        for token in tokens:\n60\t            padded = f\"#{token}#\"\n61\t            features.extend(padded[i : i + 3] for i in range(len(padded) - 2))\n62\t        return features\n63\t\n64\t    def _embed(self, texts: list[str]) -> FloatArray:\n65\t        matrix = np.zeros((len(texts), self._dim), dtype=np.float32)\n66\t        for row, text in enumerate(texts):\n67\t            for feature in self._features(text):\n68\t                digest = hashlib.blake2b(feature.encode(\"utf-8\"), digest_size=8).digest()\n69\t                value = int.from_bytes(digest, \"big\")\n70\t                bucket = value % self._dim\n71\t                sign = 1.0 if (value >> 63) & 1 else -1.0\n72\t                matrix[row, bucket] += sign\n73\t        return l2_normalize(matrix)\n74\t\n75\t    def embed_documents(self, texts: list[str]) -> FloatArray:\n76\t        return self._embed(texts)\n77\t\n78\t    def embed_queries(self, texts: list[str]) -> FloatArray:\n79\t        return self._embed(texts)\n80\t\n81\t\n82\tclass SentenceTransformersEmbedder:\n83\t    \"\"\"sentence-transformers wrapper with E5 ``query:``/``passage:`` prefixes.\n84\t\n85\t    Constructing this downloads the weights on first use. The download is pinned to\n86\t    ``revision`` when one is given and authenticated with ``HF_TOKEN`` when present,\n87\t    so a private or gated model works without a separate login step.\n88\t    \"\"\"\n89\t\n90\t    def __init__(self, model_name: str, revision: str | None = None) -> None:\n91\t        try:\n92\t            from sentence_transformers import SentenceTransformer\n93\t        except ImportError as exc:\n94\t            msg = (\n95\t                \"embedding provider 'sentence_transformers' needs the optional 'st' \"\n96\t                \"extra, which the default install does not include.\\n\"\n97\t                \"  install it   : uv sync --extra st       (or: make install-prod)\\n\"\n98\t                \"  or stay local: --config configs/tiny.yaml   \"\n99\t                \"(kedro: --params embedding.provider=hash)\\n\"\n100\t                \"The hash embedder is a first-class offline provider, not a stub — it \"\n101\t                \"needs no download and keeps builds byte-for-byte reproducible.\"\n102\t            )\n103\t            raise ConfigError(msg) from exc\n104\t        self._model_name = model_name\n105\t        self._revision = revision\n106\t        self._model = SentenceTransformer(\n107\t            model_name,\n108\t            revision=revision,\n109\t            token=os.environ.get(\"HF_TOKEN\") or None,\n110\t        )\n111\t        self._is_e5 = \"e5\" in model_name.lower()\n112\t\n113\t    @property\n114\t    def identifier(self) -> str:\n115\t        return self._model_name\n116\t\n117\t    @property\n118\t    def dim(self) -> int:\n119\t        return int(self._model.get_sentence_embedding_dimension())\n120\t\n121\t    def _embed(self, texts: list[str], prefix: str) -> FloatArray:\n122\t        prefixed = [f\"{prefix}{text}\" for text in texts] if self._is_e5 else texts\n123\t        vectors = self._model.encode(prefixed, convert_to_numpy=True, show_progress_bar=False)\n124\t        return l2_normalize(np.asarray(vectors, dtype=np.float32))\n125\t\n126\t    def embed_documents(self, texts: list[str]) -> FloatArray:\n127\t        return self._embed(texts, \"passage: \")\n128\t\n129\t    def embed_queries(self, texts: list[str]) -> FloatArray:\n130\t        return self._embed(texts, \"query: \")\n131\t\n132\t\n133\tdef create_embedding_provider(\n134\t    config: EmbeddingConfig, *, offline: bool = False\n135\t) -> EmbeddingProvider:\n136\t    if config.provider == \"hash\":\n137\t        return HashEmbedder(dim=config.dim)\n138\t    if offline:\n139\t        msg = (\n140\t            \"offline mode: provider 'sentence_transformers' may require a model \"\n141\t            \"download; use provider 'hash'\"\n142\t        )\n143\t        raise ConfigError(msg)\n144\t    return SentenceTransformersEmbedder(config.model, revision=config.revision)\n145\t"}]},"uuid":"b0fc5bd6-5389-4a47-9745-7a2ade10cb76","timestamp":"2026-08-08T09:12:09.116Z","toolUseResult":{"type":"text","file":{"filePath":"/workspaces/cybernaut_mini/src/cybernaut_mini/providers/embeddings.py","content":"\"\"\"Embedding providers behind a common protocol.\n\n``HashEmbedder`` is a first-class deterministic offline provider (feature hashing of\ntokens and character trigrams), not a test mock. ``SentenceTransformersEmbedder``\nwraps E5-style models and is the quality option; it may download weights on first use.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nfrom typing import Protocol\n\nimport numpy as np\nimport numpy.typing as npt\n\nfrom cybernaut_mini.config import ConfigError, EmbeddingConfig\nfrom cybernaut_mini.text import TextProcessor\n\nFloatArray = npt.NDArray[np.float32]\n\n\nclass EmbeddingProvider(Protocol):\n    @property\n    def identifier(self) -> str: ...\n\n    @property\n    def dim(self) -> int: ...\n\n    def embed_documents(self, texts: list[str]) -> FloatArray: ...\n\n    def embed_queries(self, texts: list[str]) -> FloatArray: ...\n\n\ndef l2_normalize(matrix: FloatArray) -> FloatArray:\n    norms = np.linalg.norm(matrix, axis=1, keepdims=True)\n    norms[norms == 0.0] = 1.0\n    return (matrix / norms).astype(np.float32)\n\n\nclass HashEmbedder:\n    \"\"\"Deterministic feature-hashing embedder: tokens + char trigrams -> signed buckets.\"\"\"\n\n    def __init__(self, dim: int = 256) -> None:\n        self._dim = dim\n        self._processor = TextProcessor(use_spacy=False)\n\n    @property\n    def identifier(self) -> str:\n        return f\"hash-{self._dim}\"\n\n    @property\n    def dim(self) -> int:\n        return self._dim\n\n    def _features(self, text: str) -> list[str]:\n        tokens = self._processor.tokenize(text)\n        features = list(tokens)\n        for token in tokens:\n            padded = f\"#{token}#\"\n            features.extend(padded[i : i + 3] for i in range(len(padded) - 2))\n        return features\n\n    def _embed(self, texts: list[str]) -> FloatArray:\n        matrix = np.zeros((len(texts), self._dim), dtype=np.float32)\n        for row, text in enumerate(texts):\n            for feature in self._features(text):\n                digest = hashlib.blake2b(feature.encode(\"utf-8\"), digest_size=8).digest()\n                value = int.from_bytes(digest, \"big\")\n                bucket = value % self._dim\n                sign = 1.0 if (value >> 63) & 1 else -1.0\n                matrix[row, bucket] += sign\n        return l2_normalize(matrix)\n\n    def embed_documents(self, texts: list[str]) -> FloatArray:\n        return self._embed(texts)\n\n    def embed_queries(self, texts: list[str]) -> FloatArray:\n        return self._embed(texts)\n\n\nclass SentenceTransformersEmbedder:\n    \"\"\"sentence-transformers wrapper with E5 ``query:``/``passage:`` prefixes.\n\n    Constructing this downloads the weights on first use. The download is pinned to\n    ``revision`` when one is given and authenticated with ``HF_TOKEN`` when present,\n    so a private or gated model works without a separate login step.\n    \"\"\"\n\n    def __init__(self, model_name: str, revision: str | None = None) -> None:\n        try:\n            from sentence_transformers import SentenceTransformer\n        except ImportError as exc:\n            msg = (\n                \"embedding provider 'sentence_transformers' needs the optional 'st' \"\n                \"extra, which the default install does not include.\\n\"\n                \"  install it   : uv sync --extra st       (or: make install-prod)\\n\"\n                \"  or stay local: --config configs/tiny.yaml   \"\n                \"(kedro: --params embedding.provider=hash)\\n\"\n                \"The hash embedder is a first-class offline provider, not a stub — it \"\n                \"needs no download and keeps builds byte-for-byte reproducible.\"\n            )\n            raise ConfigError(msg) from exc\n        self._model_name = model_name\n        self._revision = revision\n        self._model = SentenceTransformer(\n            model_name,\n            revision=revision,\n            token=os.environ.get(\"HF_TOKEN\") or None,\n        )\n        self._is_e5 = \"e5\" in model_name.lower()\n\n    @property\n    def identifier(self) -> str:\n        return self._model_name\n\n    @property\n    def dim(self) -> int:\n        return int(self._model.get_sentence_embedding_dimension())\n\n    def _embed(self, texts: list[str], prefix: str) -> FloatArray:\n        prefixed = [f\"{prefix}{text}\" for text in texts] if self._is_e5 else texts\n        vectors = self._model.encode(prefixed, convert_to_numpy=True, show_progress_bar=False)\n        return l2_normalize(np.asarray(vectors, dtype=np.float32))\n\n    def embed_documents(self, texts: list[str]) -> FloatArray:\n        return self._embed(texts, \"passage: \")\n\n    def embed_queries(self, texts: list[str]) -> FloatArray:\n        return self._embed(texts, \"query: \")\n\n\ndef create_embedding_provider(\n    config: EmbeddingConfig, *, offline: bool = False\n) -> EmbeddingProvider:\n    if config.provider == \"hash\":\n        return HashEmbedder(dim=config.dim)\n    if offline:\n        msg = (\n            \"offline mode: provider 'sentence_transformers' may require a model \"\n            \"download; use provider 'hash'\"\n        )\n        raise ConfigError(msg)\n    return SentenceTransformersEmbedder(config.model, revision=config.revision)\n","numLines":145,"startLine":1,"totalLines":145}},"sourceToolAssistantUUID":"245aecc8-4b6a-46d7-bd67-2044d2fcb87d","session_id":"1739850f-85bf-4d10-b02b-a0b2492e7df8","userType":"external","entrypoint":"cli","cwd":"/workspaces/cybernaut_mini","sessionId":"1739850f-85