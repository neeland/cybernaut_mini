# Copy to `.env` and fill in, or run `make env` to sync values automatically
# from the sibling repos (../numerai/.env, ../nosible-py/.env). `.env` is
# gitignored.
#
# `make env` also mirrors these into .claude/settings.local.json so Claude
# Code can expand ${VAR} references in .mcp.json (restart the session after
# the first sync for MCP servers to pick them up).

# Exa search MCP server (https://dashboard.exa.ai/api-keys)
EXA_API_KEY=

# Numerai tournament MCP server ("Token <numerai-mcp-api-key>")
NUMERAI_MCP_AUTH=

# Numerai tournament API (https://numer.ai/account -> "Your API keys")
NUMERAI_PUBLIC_ID=
NUMERAI_SECRET_KEY=

# Nosible search MCP server (https://www.nosible.ai)
NOSIBLE_API_KEY=

# Hugging Face MCP server — read-scope token (https://huggingface.co/settings/tokens).
# Sent as "Authorization: Bearer <token>" to https://huggingface.co/mcp.
HF_TOKEN=

# GitHub MCP server — a Personal Access Token (https://github.com/settings/tokens).
# Fine-grained or classic; sent as "Authorization: Bearer <token>" to the hosted
# server at https://api.githubcopilot.com/mcp/.
GITHUB_PERSONAL_ACCESS_TOKEN=

# Query stage 1 translation (https://openrouter.ai/keys). Read from the
# environment at call time by `query.s1_language.translate`, which defaults to
# OpenRouter's base_url and `google/gemma-3n-e4b-it` — the provider the blog post
# itself uses. This is the only stage that calls a hosted model; everything else
# runs offline. ANTHROPIC_API_KEY is deliberately not accepted here (Anthropic's
# API is not OpenAI-compatible).
OPENROUTER_API_KEY=

# Second choice for the same stage, consulted only when OPENROUTER_API_KEY is
# empty. Also the slot for a self-hosted OpenAI-compatible server (vLLM, Ollama,
# llama.cpp): point the translator at it with
# `Translator(base_url="http://localhost:11434/v1")` and set any non-empty value
# here, since those servers ignore the credential. There is no env var for
# base_url — it is a constructor argument.
OPENAI_API_KEY=
