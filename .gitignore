.omc/
.DS_Store
.env
.claude/settings.local.json
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
artifacts/*
!artifacts/.gitkeep
dist/
conf/local/*
!conf/local/.gitkeep
.viz/

# Kedro data layers. Fetched and derived corpora are rebuildable from a pinned
# source, so they are never committed; data/sample and data/00_reference are.
data/01_raw/*
!data/01_raw/.gitkeep
!data/01_raw/fixtures/
!data/01_raw/fixtures/*.jsonl
data/02_intermediate/*
!data/02_intermediate/.gitkeep
data/03_primary/*
!data/03_primary/.gitkeep
# The model layer is derived too, and the largest of them: the chunked embedding
# cache under here runs to hundreds of megabytes. It is keyed by embedder id and
# revision, so it is rebuilt rather than carried.
data/06_models/*
!data/06_models/.gitkeep
data/08_reporting/*
!data/08_reporting/.gitkeep
